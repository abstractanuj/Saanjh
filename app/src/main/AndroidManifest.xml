<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <application
        android:name=".EscapeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EscapeLauncher.Splash"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <activity
            android:name="com.geecee.escapelauncher.feature.settings.SettingsActivity"
            android:theme="@style/Theme.EscapeLauncher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.geecee.escapelauncher.feature.settings.FavoriteContactsActivity"
            android:theme="@style/Theme.EscapeLauncher"
            android:label="People"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sareprne.saanjh.action.OPEN_PEOPLE_SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DirectCallHelperActivity"
            android:theme="@style/Theme.EscapeLauncher.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false">
            <intent-filter>
                <action android:name="com.sareprne.saanjh.action.DIRECT_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AwarenessNudgeActivity"
            android:theme="@style/Theme.EscapeLauncher.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:exported="false">
            <intent-filter>
                <action android:name="com.sareprne.saanjh.action.AWARENESS_NUDGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".IconPackActivity"
            android:label="saanjh Icon Pack"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.novalauncher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dlto.atom.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.fede.launcher.THEME_ICONPACK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.sec.android.app.launcher.THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherSwitcherActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service
            android:name=".LauncherTileService"
            android:icon="@drawable/ic_launcher_tile"
            android:label="Switch Launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Khoj Search Components -->
        <activity
            android:name="com.geecee.escapelauncher.feature.widgets.KhojSearchActivity"
            android:theme="@style/Theme.EscapeLauncher.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <receiver
            android:name="com.geecee.escapelauncher.feature.widgets.KhojWidgetProvider"
            android:label="Khoj"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/khoj_widget_info" />
        </receiver>

        <!-- People Atom Cloud Widget Components -->
        <receiver
            android:name="com.geecee.escapelauncher.feature.widgets.people.PeopleWidgetProvider"
            android:label="People"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sareprne.saanjh.action.METRO_TILE_TAP" />
                <action android:name="com.sareprne.saanjh.action.REFRESH_PEOPLE_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/people_widget_info" />
        </receiver>

        <service
            android:name="com.geecee.escapelauncher.feature.widgets.people.PeopleWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Anuj Minimal & Cloud Greeting Widgets -->
        <receiver
            android:name="com.geecee.escapelauncher.feature.widgets.greeting.AnujGreetingWidgetProvider"
            android:label="Saanjh Greeting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.sareprne.saanjh.action.CYCLE_ANUJ_GREETING" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anuj_greeting_widget_info" />
        </receiver>

        <receiver
            android:name="com.geecee.escapelauncher.feature.widgets.greeting.AnujCloudGreetingWidgetProvider"
            android:label="Saanjh Cloud Greeting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.sareprne.saanjh.action.CYCLE_ANUJ_CLOUD_GREETING" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/anuj_cloud_greeting_widget_info" />
        </receiver>

        <service
            android:name="com.geecee.escapelauncher.feature.widgets.KhojTileService"
            android:icon="@drawable/ic_khoj_road"
            android:label="Khoj"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name="com.geecee.escapelauncher.feature.settings.IconPackSettingsActivity"
            android:theme="@style/Theme.EscapeLauncher.Transparent"
            android:exported="false" />

    </application>
</manifest>